{
  "name": "line-ai-ops-agent",
  "version": "0.1.0",
  "description": "A zero-cost, local-first AI operations agent controlled through LINE, with safe project monitoring, deterministic fallbacks, and free AI providers.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "dry-run": "tsx src/cli.ts",
    "db:migrate": "tsx src/persistence/migrate-cli.ts"
  },
  "dependencies": {
    "@line/bot-sdk": "^11.2.0",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
